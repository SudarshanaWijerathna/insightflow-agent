# Gemini LLM
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# InsightFlow Backend Adapter
INSIGHTFLOW_API_URL=http://localhost:8000
INSIGHTFLOW_AGENT_KEY=insightflow-agent-secret-key

# Notion Integration
NOTION_API_KEY=ntn_your_notion_integration_token
NOTION_PAGE_ID=your_parent_notion_page_or_database_id

# GitHub Integration
GITHUB_TOKEN=ghp_your_personal_access_token
GITHUB_REPO=your_username/your_repo

# Slack Integration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_DEFAULT_CHANNEL=#general

# Mock Integrations Fallback (Simulates calls if real tokens are absent)
MOCK_INTEGRATIONS_IF_UNCONFIGURED=true
